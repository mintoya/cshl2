@using @import @path "lib/bind.cshl";
// typed declarations

def type = @type();
def i32  = @sint() as type;

def x =~ 5 as i32;
def y =~ 6 as i32;
let z =~ 0 as i32;
// same as z = (z+1)
// ~ and | apply pareenthesis
// a ~ ... -> a(...)
// a + ~ b + c -> a + (b + c)
// ... | ... -> (...)...
// a b | b c -> (ab) bc
// a + b | - c * d -> (a + b) - c * d
z =~ x + y;

(z == 11)
