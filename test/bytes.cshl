@using @import @path "lib/bind.cshl";
@using @import @path "lib/fn.cshl";
@using @import @path "lib/if.cshl";

def type = @type();
def void = @void() as type;
def any  = @any() as type;
def bool = @bool() as type;
def false = (0 == 1) as @comptime(bool);
def true  = (1 == 1) as @comptime(bool);
def asBytes =~ fn [v as any] any {
  def t = @typeof(v);
  def n = @sizeof(t);
  @at((@where v) as @ptr@arr[n,@schar()])
};

def memEql =~ fn [a as any, b as any] bool
  if @sizeof(@typeof(a)) == @sizeof(@typeof(a)) ({
    def amem = asBytes(a);
    def bmem = asBytes(b);
    let curr = 0 as @ulonglong();
    @loop{
      if @get[amem,curr] == @get[bmem,curr] 
      ({ curr = curr + 1;
        if curr != (@sizeof(@typeof(amem))) 
          (@repeat(),
          {});
        },
        {});
    };
    curr == (@sizeof(@typeof(amem)))
  }, false);

memEql("hello","hello") 
  and (memEql("hello","hell1") == false)
