// error: an iterator's next must return ?(Item)
// the impl is checked when it's registered, not where it's first used
@using @import @path "lib/bind.cshl";
@using @import @path "lib/fn.cshl";
@using @import @path "lib/iter.cshl";
i32 <~ @sint();
Counter <~ @struct{ n <- 0 as i32; };
Iterator.impl(Counter, @struct{
  Item  <~ i32;
  State <~ Counter;
  start <~ [c as Counter] -> Counter c;
  next  <~ [s as @refT(Counter)] -> i32 { s.n = s.n + 1; s.n };
});
