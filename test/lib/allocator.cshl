@using @import @path "bind.cshl";
@using @import @path "fn.cshl";
@using @import @path "if.cshl";
@using @import @path "slice.cshl";
@using @import @path "types.cshl";

allocator <~ @struct{
  allocatorType <~ @fnptr[[@refT@this(),@ptr(uc),ull,ull],@ptr(uc)];
  fn <- allocatorType();
  Self <~ @this();
  RSelf<~ @refT(Self);

  resize <~ [
    self  as RSelf,
    value as any,
    count as ull,
  ]->@typeof(value) {
    result <- value;
    result.ptr = self:fn(
      result.ptr as @ptr(uc),
      result.len,
      count
    ) as @typeof(result.ptr);
    result.len = count;
    result
  };
  alloc <~ ([
    self  as RSelf,
    t     as type,
    count as ull
  ]->slice(t) 
    self:resize(@returntype()(),count));
  free <~ ([
    self  as RSelf,
    value as any,
  ]->void 
    self:resize(value,0 as ull));
  // must be at end obviously
  ctx <- @arr[0,ull]();
};

@cinclude "stdlib.h";

c_runtime_allocator <- { 
  tmp <- allocator();
  tmp.fn = ([
    _unused as @refT(allocator),
    mem     as @ptr(uc),
    from    as ull,
    to      as ull,
  ] -> @ptr(uc) 
    @cexpr[@typeof(@returntype()()),"realloc(a1,a3)"]);
  tmp
};

