@using @import @path "bind.cshl";
@using @import @path "fn.cshl";
@using @import @path "if.cshl";
@using @import @path "slice.cshl";
@using @import @path "types.cshl";

def allocator = @struct{
  def allocatorType = @fnptr[[@refT@this(),@ptr(uc),ull,ull],@ptr(uc)];
  let func = allocatorType();
  def Self = @this();
  def RSelf = @refT(Self);

  def resize =~ fn [
    self  as RSelf,
    value as any,
    count as ull,
  ] @typeof(value) {
    let result = value;
    result.ptr = self:func(
      result.ptr as @ptr(uc),
      result.len,
      count
    ) as @typeof(result.ptr);
    result.len = count;
    result
  };
  def alloc =~ fn [
    self  as RSelf,
    t     as type,
    count as ull
  ] slice(t)
    self:resize(@returntype()(),count);
  def free =~ fn [
    self  as RSelf,
    value as any,
  ] void
    self:resize(value,0 as ull);
    
  // must be at end obviously
  let ctx = @arr[0,ull]();
};

@cinclude "stdlib.h";

def discard =~ fn [id as ast] inline '{ def _ = `id; };
let c_runtime_allocator = { 
  let tmp = allocator();
  tmp.func =~ fn [
    _unused as @refT(allocator),
    mem     as @ptr(uc),
    from    as ull,
    to      as ull,
  ] @ptr(uc) {
    discard mem; discard from; discard to;
    @cexpr[@typeof(@returntype()()),"realloc(a1,a3)"] 
  };
  tmp
};

// let xs = c_runtime_allocator:alloc(uc,5);
// @defer c_runtime_allocator:free(xs);
// xs = c_runtime_allocator:resize(xs,6);
// 
// xs:get[0] = @get["h",0];
// xs:get[1] = @get["f",0];
// xs:get[2] = @get["l",0];
// xs:get[3] = @get["l",0];
// xs:get[4] = @get["o",0];
// xs:get[5] = 0 as i8;

@struct{
  def c_runtime_allocator = c_runtime_allocator;
}
