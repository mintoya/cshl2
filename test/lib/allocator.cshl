@using @import @path "meta.cshl";
@using @import @path "slice.cshl";

def allocator = @struct{
  def allocatorType = @fnptr[[@refT@this(),@ptr(uc),ull,ull],@ptr(uc)];
  let func = allocatorType();
  def Self = @this();
  def RSelf = @refT(Self);

  def resize =~ fn [
    self  as RSelf,
    value as any,
    count as ull,
  ] @typeof(value) {
    let result = value;
    result.ptr = self:func(
      result.ptr as @ptr(uc),
      result.len,
      count
    ) as @typeof(result.ptr);
    result.len = count;
    result
  };
  def alloc =~ fn [
    self  as RSelf,
    t     as type,
    count as ull
  ] slice(t)
    self:resize(@returntype()(),count);
  def free =~ fn [
    self  as RSelf,
    value as any,
  ] void
    self:resize(value,0 as ull);
    
  // must be at end obviously
  let ctx = @arr[0,ull]();
};

@cinclude "stdlib.h";

def discard =~ fn [id as ast] inline '{ def _ = `id; };
let c_runtime_allocator = { 
  let tmp = allocator();
  tmp.func =~ fn [
    _unused as @refT(allocator),
    mem     as @ptr(uc),
    from    as ull,
    to      as ull,
  ] @ptr(uc) {
    discard mem; discard from; discard to;
    @cexpr[@ptr(uc),"realloc(a1,a3)"] 
  };
  tmp
};

@struct{
  let c_runtime_allocator = c_runtime_allocator;
}
