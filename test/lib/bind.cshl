@bind[def, @fn[[a as @ast()], @inlineast(), {
  @if[@ast_stringeq(@get[a, 0], "=") == (0 == 1), @compileError("expected def name = value")];
  '@bind[`(@get[a, 1]), `(@get[a, 2])]
}]];
@bind[let, @fn[[a as @ast()], @inlineast(), {
  @if[@ast_stringeq(@get[a, 0], "=") == (0 == 1), @compileError("expected let name = value")];
  @bind[name, @get[a, 1]];
  @bind[value, @get[a, 2]];
  '(@bind[`name, @at@alloca[@typeof(`value)]] = `value)
}]];

@struct{
  def def = def;
  def let = let;
}
