// combine(a, b): one struct with the members of both: the namespaces through
// @using, and each field bound to a value's, so it keeps its default.
@using @import @path "bind.cshl";
@using @import @path "fn.cshl";
type <~ @type();

// `@bind[n, v.n]` for each field n of T: in a @struct block, a field of v
// bound like that is a field, with v's value as its default
fields <~ [T as type, v as @ast()] -> @ast() {
  out <- '{};
  i <- 0;
  @loop @if[i < @len(T), {
    n <~ @fieldname(T, i);
    @if[@iscomptime(@fieldval(T(), i)) == (1 == 0), out = '{ ..`out; @bind[`n, (`v).`n]; }];
    i = i + 1;
    @repeat()
  }];
  out
};

combine <~ [a as type, b as type] -> type {
  av <- a();
  bv <- b();
  @struct `('{ @using a; @using b; ..`(fields(a, av)); ..`(fields(b, bv)); })
};

@struct{ combine <~ combine; }
