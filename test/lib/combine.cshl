// combine(a, b): one struct with the members of both, in order: fields with
// their defaults, namespace members with their values. Built as syntax, one
// declaration per member, then made with @struct `fields.
@using @import @path "bind.cshl";
@using @import @path "fn.cshl";
type <~ @type();

combine <~ [a as type, b as type] -> type {
  av <~ a();
  bv <~ b();
  fields <- '{};
  i <- 0;
  @loop @if[i < @len(a), {
    n <~ @fieldname(a, i);
    fields = '{..`fields; `(@if[@iscomptime(@fieldval(av, i)),
      '(@bind[`n, av.`n]),
      '(@bind[`n, @at@alloca[@typeof(av.`n)]] = av.`n)])};
    i = i + 1;
    @repeat()
  }];
  i = 0;
  @loop @if[i < @len(b), {
    n <~ @fieldname(b, i);
    fields = '{..`fields; `(@if[@iscomptime(@fieldval(bv, i)),
      '(@bind[`n, bv.`n]),
      '(@bind[`n, @at@alloca[@typeof(bv.`n)]] = bv.`n)])};
    i = i + 1;
    @repeat()
  }];
  @struct `fields
};

@struct{ combine <~ combine; }
