// iteration as a trait. A type is iterable when it has an Iterator impl:
//   Item   the element type
//   State  where an iteration is up to
//   start  [c as C] -> State
//   next   [s as @refT(State)] -> ?(Item): the next element, or none
// and next's return type is checked when the impl is registered.
//   for(c) |> each { ..._.. }   runs the block for each element, as _
@using @import @path "bind.cshl";
@using @import @path "fn.cshl";
@using @import @path "trait.cshl";
@using @import @path "optional.cshl";

type <~ @type();
any  <~ @any();

Iterator <~ trait_checked("Iterator", [I as type] -> type {
  @if[@fieldtype(@typeof(I.next), 1) != ?(I.Item),
    @compileError("an iterator's next must return ?(Item)")];
  I
});

// an iteration in progress: the impl, and its state
Running <~ [I as type] -> type @struct{
  impl  <~ I;
  state <- @zero(I.State);
};

// the iteration of c, by its type's Iterator impl
for <~ [c as any] -> any {
  I <~ Iterator.of(@typeof(c));
  r <- Running(I)();
  r.state = I.start(c);
  r
};

// it |> each {body}: runs body for each element of the iteration piped in
// as _, with the element bound to _
each <~ [body as @ast()] -> @inlineast() {
  s <~ @gensym(s);
  v <~ @gensym(v);
  '{
    @bind[`s, @at@alloca[@typeof(_)]];
    `s = _;
    @loop {
      @bind[`v, @typeof(`s).impl.next((`s).state)];
      @if[(`v).present, {
        @bind[_, (`v).value];
        `body;
        @repeat()
      }];
    };
  }
};

range <~ [start as any, end as any] -> any {
  @using @import @path "if.cshl";
  ResultType <~ @struct {
    place <- start;
    end   <~ end;
  };
  postinc[value as anyref]->any{
    result <~ value as any;
    value = value + 1;
    result
  };
  Iterator.impl(ResultType, @struct{
    Item  <~ @typeof(start);
    State <~ ResultType;
    start <~ [i as ResultType] -> ResultType i;
    next  <~ [s as @refT(ResultType)] -> ?Item 
      if s.place < s.end 
        (postinc(s.place) as @returntype(), null);
  });
  ResultType()
};

@struct{
  Iterator <~ Iterator;
  for <~ for;
  each <~ each;
  range <~ range;
}
