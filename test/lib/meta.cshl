@using @import @path "bind.cshl";
@struct{
  loop    <~ @loop;
  loop    <~ @thisloop();
  repeat  <~ @repeat;
  struct  <~ @struct;
  true    <~ (1 == 1);
  false   <~ (1 != 1);
  @using @import @path "fn.cshl";
  @using @import @path "if.cshl";
  @using @import @path "match.cshl";
  @using @import @path "optional.cshl";
  @using @import @path "types.cshl";
}
