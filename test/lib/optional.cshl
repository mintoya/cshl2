@using @import @path "bind.cshl";
@using @import @path "fn.cshl";
@using @import @path "if.cshl";
@using @import @path "types.cshl";

null <~ @void()();
? <~ ((
  T as type,
) -> type { 
  result <~ @struct{
    present <- (1 != 1) as bool;
    value   <- @zero(T);
    orelse  <~ (self as ast, otherwise as ast) -> inline {
      temp <~ @gensym(temp);
      '{
        `temp <~ `self;
        `@outlineast(if (`temp).present 
          ((`temp).value, `otherwise))
      }
    };
    null <~ @this()();
    from <~ [value as T]->@this() {
      result <- @returntype()();
      result.present = (1==1);
      result.value = value;
      result
    };
  };
  result
});

/*
test "optionals example" {
  x <- (?ull).null;
  x = x.from(x:orelse{6 as ull});
  x.value == 6
};
*/

@struct{
  ? <~ ?;
  null <~ null;
}
