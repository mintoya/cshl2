@using @import @path "bind.cshl";
@using @import @path "fn.cshl";
@using @import @path "if.cshl";
@using @import @path "types.cshl";

def null = @void()();
def ? =~ fn [
  T as type,
] type { 
  def result = @struct{
    let present = (1 != 1) as bool;
    let value   = @zero(T);
    def orelse  =~ fn [self as ast, otherwise as ast] inline {
      def temp = @gensym(temp);
      '{
        def `temp = `self;
        `@outlineast(if (`temp).present 
          ((`temp).value, `otherwise))
      }
    };
    def null = @this()();
    def from =~ fn [value as T] @this() {
      let result = @returntype()();
      result.present = (1==1);
      result.value = value;
      result
    };
  };
  result
};

/*
test "optionals example" {
  let x = (?ull).null;
  x = x.from(x:orelse{6 as ull});
  x.value == 6
};
*/

@struct{
  def ? = ?;
  def null = null;
}
