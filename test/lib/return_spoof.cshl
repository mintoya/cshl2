@using @import @path "test/lib/bind.cshl";
@using @import @path "test/lib/fn.cshl";
@using @import @path "test/lib/if.cshl";
@using @import @path "test/lib/types.cshl";

def using_return =~ fn [body as ast] inline {
 let returned = @gensym(returned);
 let return_yield  = @gensym(return_yield);
 let loop  = @gensym(loop);
 '{
    def return =~ fn [in as ast] inline '{
      `returned= (1==1);
      `return_yield = \`in;
      @repeat(`loop);
    };
    let `return_yield = @returntype()();
    let `returned = (0 == 1);
     @loop @if[`returned,{},{
      @bind[`loop,@thisloop()];
      `body;
    }];
    `return_yield 
 }
};
(fn [] ill using_return {
  if (1==0) (
    return 6 as ill,
    return 5 as ill);
})() == 5
