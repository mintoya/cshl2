@using @import @path "meta.cshl";

def slice =~ fn [T as type] type {
  def S = @struct{
    def Self = @this();
    def RSelf = @refT@this();
    let ptr = @zero(@ptr(@arr[0, T]));
    let len = 0 as ull;
    def get =~ fn [self as Self, i as ull] @refT(T) @get[@at(self.ptr), i];
    def last =~ fn [self as Self] @refT(T) @get[@at(self.ptr), self.len- 1];
    def sub =~ fn [self as Self, start as ull, end as ull] Self {
      let r = Self();
      r.ptr = (@where self:get(start)) as @ptr(@arr[0, T]);
      r.len = end - start;
      r
    };
    def of =~ fn [array as  anyref] Self {
      if @membertype(@typeof(array)) != T 
        @compileError("wrong array type");
      let result = @returntype()();
      result.len = @len(array) as ull;
      result.ptr = @where(array) as @typeof(result.ptr);
      result 
    };
    def cpy =~ fn [self as Self , b as Self] void {
      let place = 0 as ull;
      def reverse = (self.ptr as ull) > (b.ptr as ull);
      loop if place < min(self.len, b.len) {
        self:get[place] = b:get[place];
        place = place + 1;
        @repeat();
      };
    };
    def asbytes =~ fn [this as any] slice(uc) ~ 
      @returntype()() |> {
        _.ptr = (this.ptr as @typeof(_.ptr));
        _.len = (this.len * (@sizeof(T) as ull));
        _
      };
  };
  S
};

@struct{
  def slice = slice;
}
