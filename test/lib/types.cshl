@using @import @path "bind.cshl";

def type  = @type();
@struct{
  def type  = type;
  def vtype = @volatile@type();

  def ull   = @ulonglong() as type;
  def ul    = @ulong()     as type;
  def ui    = @uint()      as type;
  def us    = @ushort()    as type;
  def uc    = @uchar()     as type;
  def ill   = @slonglong() as type;
  def il    = @slong()     as type;
  def ii    = @sint()      as type;
  def is    = @sshort()    as type;
  def ic    = @schar()     as type;


  def void  = @void()      as type;
  def any   = @any()       as type;
  def anyref= @refT@any()  as type;
  def ast   = @ast()       as type;
  def inline= @inlineast() as type;
  def astval= @volatile@ast() as type;
  def bool  = @bool()      as type;
}
