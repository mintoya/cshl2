// Repeats resolve to depths 0, 1, and 2 through intervening if scopes.
@using @import @path "lib/meta.cshl";

let outer_count   = 0 as ii;
let middle_count  = 0 as ii;
let inner_count   = 0 as ii;
let inner_tail    = 0 as ii;
let middle_tail   = 0 as ii;
let outer_tail    = 0 as ii;

loop { def outer = @thisloop();
  outer_count = outer_count + 1;
  let middle_iteration = 0 as ii;
   loop { def middle = @thisloop();
    middle_count = middle_count + 1;
    middle_iteration = middle_iteration + 1;
    let inner_iteration = 0 as ii;
    loop {
      inner_count = inner_count + 1;
      inner_iteration = inner_iteration + 1;

      if inner_count < 20 {
        if inner_iteration < 2 
          repeat();
        if middle_iteration < 2
          repeat(middle);
        if outer_count < 3 
          repeat(outer);
      };
      inner_tail = inner_tail + 1;
    };
    middle_tail = middle_tail + 1;
  };
  outer_tail = outer_tail + 1;
};

(outer_count == 3)  and 
(middle_count == 6) and 
(inner_count == 12) and 
(inner_tail == 1)   and 
(middle_tail == 1)  and 
(outer_tail == 1)
