// a |> f is f applied to a, left to right: x |> f |> g is g(f(x))
@bind[inc, @fn[[x as @sint()], @sint(), x + 1]];
@bind[twice, @fn[[x as @sint()], @sint(), x * 2]];
@bind[add, @fn[[n as @sint()], @any(), @fn[[x as @sint()], @sint(), x + n]]];
@bind[v, @at@alloca[@sint()]];
v = 3;
((v |> inc |> twice) == 8) and ((v |> add 10) == 13)
