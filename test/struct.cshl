@using @import @path "lib/bind.cshl";
@using @import @path "lib/fn.cshl";

i32 <~ @sint();
type<~ @type();

si32 <~ @struct{
  Self  <~ @this() as type;
  RSelf <~ @refT@this() as type;
  zi32  <~ @fn[[],i32,0 as i32];

  self  <- (0 as i32);
  add   <~ ([self as RSelf, a as i32] -> i32
    self.self = self.self + a);
};
x <- si32();

(x:add(5) == 5)
  and (x:add(5)      == 10)
  and (x.add(x,5)    == 15)
  and (x.zi32()      == (0 as i32))
  and (@sizeof(@typeof(x)) == @sizeof(i32))
