@using @import @path "lib/bind.cshl";
@using @import @path "lib/fn.cshl";

def i32 = @sint();
def type = @type();

def si32 = @struct{
  def Self  = @this() as type;
  def RSelf = @refT@this() as type;
  def zi32  = @fn[[],i32,0 as i32];

  let self  = (0 as i32);
  def add   =~ fn [self as RSelf, a as i32] i32
    self.self = self.self + a;
};
let x = si32();

(x:add(5) == 5)
  and (x:add(5)      == 10)
  and (x.add(x,5)    == 15)
  and (x.zi32()      == (0 as i32))
  and (@sizeof(@typeof(x)) == @sizeof(i32))
